\f0\fs24 \cf0 -- **** Base CTE Definition (Includes source data for both sum and avg) ****\
WITH FinalResults AS (\
    SELECT\
        t4.Name,\
        t1.JobNum,\
        t1.OprSeq,\
        MAX(t5.PartNum) AS PartNum,\
        -- We need the underlying TotalLaborHrs per group member for AVG\
        SUM(t3.LaborHrs) AS TotalLaborHrs\
    FROM\
        `warehouse-363320.Epicor10Replication.JobOpDtl` AS t1\
    JOIN\
        `warehouse-363320.Epicor10Replication.JobOper` AS t2\
        ON t1.Company = t2.Company AND t1.JobNum = t2.JobNum AND t1.OprSeq = t2.OprSeq\
    JOIN\
        `warehouse-363320.Epicor10Replication.LaborDtl` AS t3\
        ON t1.Company = t3.Company AND t1.JobNum = t3.JobNum AND t1.OprSeq = t3.OprSeq\
    JOIN\
        `warehouse-363320.Epicor10Replication.EmpBasic` AS t4\
        ON t3.EmployeeNum = t4.EmpID\
    LEFT JOIN\
        `warehouse-363320.Epicor10Replication.JobHead` AS t5\
        ON t1.Company = t5.Company AND t1.JobNum = t5.JobNum\
    WHERE\
        t4.Name IN ('Ryan Uhric', 'Tanner Durci', 'Brian Churchfield', 'Marina DePaoli', 'Scott Bloomfield', 'Cameron Pohl', 'Dennis Deighan', 'Lincoln Runco', 'Daniel Billing', 'Anthony Gribbin', 'Abdel Aguilar')\
        AND t2.StartDate >= DATE '2025-04-01' -- <<< ADJUST START DATE FOR CURRENT ANALYSIS AS NEEDED\
        AND LEFT(t2.OpCode, 5) = 'M-CMP'\
    GROUP BY\
        t4.Name, t1.JobNum, t1.OprSeq, t1.ProdStandard -- Assuming ProdStandard was relevant to unique work instances\
        -- Grouping by Name, JobNum, OprSeq represents the total hours for that employee on that specific job-op\
        -- The AVG below will average these totals across the GROUPING SET dimensions\
),\
AggregatedResults AS (\
    -- Calculate SUM and AVG over the relevant groupings\
    SELECT\
        Name,\
        JobNum,\
        OprSeq,\
        PartNum,\
        SUM(TotalLaborHrs) AS SumTotalLaborHrs,\
        AVG(TotalLaborHrs) AS AvgTotalLaborHrs,\
        -- Add GROUPING indicators to distinguish aggregation levels\
        GROUPING(Name) AS IsNameAggregated,\
        GROUPING(JobNum) AS IsJobNumAggregated,\
        GROUPING(OprSeq) AS IsOprSeqAggregated,\
        GROUPING(PartNum) AS IsPartNumAggregated\
    FROM FinalResults\
    GROUP BY GROUPING SETS (\
        -- Req 1a: Total/Avg labor hours per JobNum, By Name\
        (Name, JobNum),\
        -- Req 1b: Total/Avg labor hours per JobNum, All Names (Selected)\
        (JobNum),\
        -- Req 2a: Total/Avg labor hours per Op, per JobNum, By Name\
        (Name, JobNum, OprSeq),\
        -- Req 2b: Total/Avg labor hours per Op, per JobNum, All Names (Selected)\
        (JobNum, OprSeq),\
        -- Req 3a: Total/Avg labor hours per Op, per PartNum, By Name\
        (Name, PartNum, OprSeq),\
        -- Req 3b: Total/Avg labor hours per Op, per PartNum, All Names (Selected)\
        (PartNum, OprSeq)\
    )\
)\
-- Final SELECT to get the desired columns\
SELECT\
    CASE WHEN IsNameAggregated = 1 THEN 'ALL_SELECTED' ELSE Name END AS Name, -- Replace NULL Name with identifier\
    JobNum,\
    OprSeq,\
    PartNum,\
    SumTotalLaborHrs,\
    AvgTotalLaborHrs,\
    -- You can select the Is...Aggregated columns too if helpful for Python filtering\
    IsNameAggregated,\
    IsJobNumAggregated,\
    IsOprSeqAggregated,\
    IsPartNumAggregated\
FROM AggregatedResults\
ORDER BY\
    IsNameAggregated, Name,\
    JobNum,\
    IsPartNumAggregated, PartNum,\
    IsOprSeqAggregated, OprSeq;}